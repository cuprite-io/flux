        "steps": [
          {
            "type": "volt",
            "script": "set('final_price', item.base_price * 0.75)"
          },
          {
            "type": "return",
            "data": {
              "item": "Ashes of Al'ar (Celestial Phoenix Mount)",
              "final_price": "$final_price",
              "mount_speed": 350.0,
              "prestige_title": "Lord of the Skies",
              "status": "CLAIMABLE"
            }
          }
        ]
      }
    }
  },
