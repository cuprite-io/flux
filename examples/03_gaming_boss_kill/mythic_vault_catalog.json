[
  {
    "id": "titanforged_thunderfury",
    "category": "catalog:mythic_vault",
    "tags": ["catalog:mythic_vault", "weapons:mythic"],
    "data": {
      "name": "Thunderfury, Blessed Blade of the Windseeker",
      "base_price": 15000.0,
      "rarity": "MYTHIC_ARTIFACT"
    },
    "circuit": {
      "id": "thunderfury_qualify",
      "root": {
        "name": "check_mythic_warrior",
        "condition": "user.level >= 60.0 && user.boss_kills >= 1.0 && user.class == 'WARRIOR'",
        "steps": [
          {
            "type": "volt",
            "script": "set('vip_discount', user.vip_tier == 'MYTHIC_LEGEND' ? 0.30 : 0.15) && set('final_price', item.base_price * (user.vip_tier == 'MYTHIC_LEGEND' ? 0.70 : 0.85))"
          },
          {
            "type": "return",
            "data": {
              "item": "Thunderfury, Blessed Blade of the Windseeker",
              "final_price": "$final_price",
              "vip_discount": "$vip_discount",
              "attack_power": 650.0,
              "perk": "CHAIN_LIGHTNING_PROC",
              "status": "CLAIMABLE"
            }
          }
        ]
      }
    }
  },
  {
    "id": "celestial_phoenix_mount",
