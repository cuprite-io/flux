{
  "id": "dungeon_progression_pipeline",
  "tags": ["stream:game_events", "stream:dungeon_events"],
  "root": {
    "name": "verify_dungeon_clear",
    "condition": "payload.dungeon_cleared == true && payload.mobs_killed >= 10.0",
    "steps": [
      {
        "type": "volt",
        "script": "set('player_id', payload.player_id) && set('class', payload.class) && set('level', 25.0) && set('gold', 2450.0) && set('gear_score', 280.0) && set('dungeon_clears', 5.0) && set('boss_kills', 0.0) && set('vip_tier', 'BRONZE')"
      },
      {
        "type": "sink",
        "sink": "player_state_sink"
      }
    ],
    "children": [
      {
        "name": "dungeon_guild_feed",
        "steps": [
          {
            "type": "sink",
            "sink": "discord_webhooks",
            "sink_type": "announcement",
            "payload": "payload"
          }
        ]
      },
      {
        "name": "rewards_calculator",
        "steps": [
          {
            "type": "return",
            "data": {
              "status": "DUNGEON_CONQUERED",
              "dungeon_name": "Sunken Catacombs",
              "player_id": "$player_id",
              "promoted_level": "$level",
              "promoted_tier": "$vip_tier",
              "gear_score": "$gear_score",
              "gold_balance": "$gold",
              "unlocked_armory": "catalog:adventurer_armory"
            }
          }
        ]
      }
    ]
  }
}
