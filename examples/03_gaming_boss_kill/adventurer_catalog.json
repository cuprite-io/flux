          },
          {
            "type": "return",
            "data": {
              "item": "Runic Ring of Fortitude",
              "final_price": "$final_price",
              "discount_pct": "$discount_pct",
              "bonus_hp": 250.0,
              "status": "AVAILABLE"
            }
          }
        ]
      }
    }
  },
  {
