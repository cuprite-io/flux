[
  {
    "id": "iron_battleaxe",
    "category": "catalog:adventurer_armory",
    "tags": ["catalog:adventurer_armory", "weapons:melee"],
    "data": {
      "name": "Iron Battleaxe",
      "base_price": 450.0,
      "item_type": "WEAPON"
    },
    "circuit": {
      "id": "iron_battleaxe_qualify",
      "root": {
        "name": "check_warrior_level",
        "condition": "user.level >= 10.0 && user.class == 'WARRIOR'",
        "steps": [
          {
            "type": "volt",
            "script": "set('discount_pct', user.level >= 50.0 ? 0.25 : (user.level >= 20.0 ? 0.10 : 0.0)) && set('final_price', item.base_price * (user.level >= 50.0 ? 0.75 : (user.level >= 20.0 ? 0.90 : 1.0)))"
          },
          {
            "type": "return",
            "data": {
              "item": "Iron Battleaxe",
              "final_price": "$final_price",
              "discount_pct": "$discount_pct",
              "attack_power": 45.0,
              "status": "AVAILABLE"
            }
          }
        ]
      }
    }
  },
  {
    "id": "stamina_runic_ring",
